# Admin (required for /admin). Personal staff log-ins: comma-separated email:hash entries, hashes only, made with
#   node scripts/hash-admin-password.mjs staff@example.com
# e.g. ADMIN_USERS=ana@example.com:s1.<salt>.<key>,ben@example.com:s1.<salt>.<key>
# When ADMIN_USERS is set, ADMIN_PASSWORD is ignored.
ADMIN_USERS=
# Legacy single shared password, used only while ADMIN_USERS is blank.
ADMIN_PASSWORD=
# 32+ random chars: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Storage: Upstash Redis REST (Vercel KV/Upstash integration names; UPSTASH_REDIS_REST_URL/_TOKEN also accepted).
# Leave blank in local dev to store in .data/*.json (gitignored). On Vercel without these, admin saves are disabled.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
# If self-hosting multiple instances, also set NEXT_SERVER_ACTIONS_ENCRYPTION_KEY.

# Member accounts (log in before request / inquire / book / purchase). 32+ random characters.
# Required in production; local development falls back to a generated .data/member-secret.txt.
MEMBER_SESSION_SECRET=

# Online payments (PayMongo). Test keys: dashboard.paymongo.com > Developers > API keys (sk_test_...).
# Webhook: register https://<your-site>/api/payments/webhook for "checkout_session.payment.paid" and paste its secret.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional: methods enabled on your PayMongo account (default gcash,paymaya).
# PAYMONGO_METHODS=gcash,paymaya
# Promo codes for checkout, comma-separated: CODE=10% (percent off), CODE=500 (PHP off), CODE=29%@athlete|premium (only those items).
PAYMENT_PROMO_CODES=
# PayPal (sandbox first): developer.paypal.com > Apps & Credentials. PAYPAL_MODE=sandbox or live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Instant class booking charges only with live keys. Set to 1 to also allow test / sandbox keys (staging only).
BOOKING_TEST_PAYMENTS=
