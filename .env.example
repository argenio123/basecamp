# Admin (required for /admin)
ADMIN_PASSWORD=
# 32+ random chars: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Storage: Upstash Redis REST (Vercel KV/Upstash integration names; UPSTASH_REDIS_REST_URL/_TOKEN also accepted).
# Leave blank in local dev to store in .data/*.json (gitignored). On Vercel without these, admin saves are disabled.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
# If self-hosting multiple instances, also set NEXT_SERVER_ACTIONS_ENCRYPTION_KEY.
